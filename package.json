{
  "name": "taskbar-hero-clone",
  "version": "0.2.0",
  "description": "A tiny idle RPG that docks to your taskbar",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check preload-inventory.js",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --dir",
    "sync-lockfile": "node scripts/sync-lockfile.mjs"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "pixi.js": "^7.4.2"
  },
  "build": {
    "appId": "io.arkansasio.taskbarhero",
    "productName": "Taskbar Hero",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "preload-inventory.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Taskbar-Hero-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Taskbar Hero"
    }
  }
}
